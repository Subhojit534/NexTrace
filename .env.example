# NexTrace Frontend Environment Variables

# Backend API Base URL (Deployed Vercel backend URL, e.g. https://your-backend.vercel.app or empty for local proxy)
VITE_API_BASE_URL=

# Supabase Google Authentication
# Create a free project at https://supabase.com -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
